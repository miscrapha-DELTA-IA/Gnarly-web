{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnarly-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["enable_request_signal"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/fast-audio/*",
      "/fast-prepare/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {"name": "KARAOKE_ROOMS", "class_name": "KaraokeRoom"}
    ]
  },
  "migrations": [
    {"tag": "karaoke-room-v1", "new_sqlite_classes": ["KaraokeRoom"]}
  ],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "GNARLY_AUDIO_R2",
      "bucket_name": "gnarly-cache"
    }
  ]
}
