{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnarly-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/fast-audio/*",
      "/fast-prepare/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "GNARLY_AUDIO_R2",
      "bucket_name": "gnarly-cache"
    }
  ]
}
