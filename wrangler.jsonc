{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gnarly-web",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
